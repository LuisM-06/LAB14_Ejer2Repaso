@page "/albumes"
@rendermode InteractiveServer

@using LAB14_Ejer2Repaso.Models
@using LAB14_Ejer2Repaso.Services
@inject JsonService jsonService

<h3>Biblioteca de Música</h3>

<h4>Datos del Álbum</h4>

<div>
    <label>Título del álbum:</label>
    <input @bind="tituloAlbum" />
</div>

<div>
    <label>Artista del álbum:</label>
    <input @bind="artistaAlbum" />
</div>

<div>
    <label>Fecha de publicación:</label>
    <input type="date" @bind="fechaPublicacion" />
</div>

<hr />

<h4>Canciones del Álbum</h4>

<div>
    <label>Nombre de la canción:</label>
    <input @bind="nombreCancion" />
</div>

<div>
    <label>Artista de la canción:</label>
    <input @bind="artistaCancion" />
</div>

<div>
    <label>Tiempo de duración:</label>
    <input type="number" step="0.01" @bind="tiempoDuracion" />
</div>

<br />

<button @onclick="AgregarCancion">Agregar Canción</button>

<h4>Canciones agregadas al álbum</h4>

<table border="1">
    <thead>
        <tr>
            <th>Nombre de la canción</th>
            <th>Artista</th>
            <th>Duración</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cancion in cancionesTemporales)
        {
            <tr>
                <td>@cancion.NombreCancion</td>
                <td>@cancion.Artista</td>
                <td>@cancion.TiempoDuracion</td>
            </tr>
        }
    </tbody>
</table>

<br />

@if (editando == false)
{
    <button @onclick="GuardarAlbum">Guardar Álbum</button>
}
else
{
    <button @onclick="ActualizarAlbum">Actualizar Álbum</button>
}

<button @onclick="LimpiarCampos">Limpiar</button>

<hr />

<h4>Buscar álbumes por artista</h4>

<div>
    <label>Artista:</label>
    <input @bind="artistaBuscar" />
</div>

<br />

<button @onclick="FiltrarPorArtista">Buscar</button>
<button @onclick="MostrarTodos">Mostrar todos</button>

<hr />

<h3>Listado de Álbumes</h3>

<table border="1">
    <thead>
        <tr>
            <th>Título del álbum</th>
            <th>Artista del álbum</th>
            <th>Fecha de publicación</th>
            <th>Canciones</th>
            <th>Editar</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var album in listaMostrar)
        {
            <tr>
                <td>@album.TituloAlbum</td>
                <td>@album.ArtistaAlbum</td>
                <td>@album.FechaPublicacion.ToShortDateString()</td>

                <td>
                    <ul>
                        @foreach (var cancion in album.Canciones)
                        {
                            <li>
                                @cancion.NombreCancion -
                                @cancion.Artista -
                                @cancion.TiempoDuracion min
                            </li>
                        }
                    </ul>
                </td>

                <td>
                    <button @onclick="() => EditarAlbum(album)">Editar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    string ruta = "albumes.json";

    List<Album> listaAlbumes = new List<Album>();
    List<Album> listaMostrar = new List<Album>();

    List<Cancion> cancionesTemporales = new List<Cancion>();

    string tituloAlbum = string.Empty;
    string artistaAlbum = string.Empty;
    DateTime fechaPublicacion = DateTime.Now;

    string nombreCancion = string.Empty;
    string artistaCancion = string.Empty;
    double tiempoDuracion;

    string artistaBuscar = string.Empty;

    bool editando = false;
    int indiceEditar = -1;

    protected override void OnInitialized()
    {
        listaAlbumes = jsonService.Leer<Album>(ruta);
        listaMostrar = listaAlbumes;
    }

    void AgregarCancion()
    {
        Cancion nuevaCancion = new Cancion();

        nuevaCancion.NombreCancion = nombreCancion;
        nuevaCancion.Artista = artistaCancion;
        nuevaCancion.TiempoDuracion = tiempoDuracion;

        cancionesTemporales.Add(nuevaCancion);

        nombreCancion = string.Empty;
        artistaCancion = string.Empty;
        tiempoDuracion = 0;
    }

    void GuardarAlbum()
    {
        Album nuevoAlbum = new Album();

        nuevoAlbum.TituloAlbum = tituloAlbum;
        nuevoAlbum.ArtistaAlbum = artistaAlbum;
        nuevoAlbum.FechaPublicacion = fechaPublicacion;
        nuevoAlbum.Canciones = cancionesTemporales;

        listaAlbumes.Add(nuevoAlbum);

        jsonService.Guardar(ruta, listaAlbumes);

        listaMostrar = listaAlbumes;

        LimpiarCampos();
    }

    void EditarAlbum(Album album)
    {
        indiceEditar = listaAlbumes.IndexOf(album);

        tituloAlbum = album.TituloAlbum;
        artistaAlbum = album.ArtistaAlbum;
        fechaPublicacion = album.FechaPublicacion;

        cancionesTemporales = new List<Cancion>();

        foreach (var cancion in album.Canciones)
        {
            cancionesTemporales.Add(cancion);
        }

        editando = true;
    }

    void ActualizarAlbum()
    {
        if (indiceEditar >= 0)
        {
            listaAlbumes[indiceEditar].TituloAlbum = tituloAlbum;
            listaAlbumes[indiceEditar].ArtistaAlbum = artistaAlbum;
            listaAlbumes[indiceEditar].FechaPublicacion = fechaPublicacion;
            listaAlbumes[indiceEditar].Canciones = cancionesTemporales;

            jsonService.Guardar(ruta, listaAlbumes);

            listaMostrar = listaAlbumes;

            LimpiarCampos();
        }
    }

    void FiltrarPorArtista()
    {
        listaMostrar = new List<Album>();

        foreach (var album in listaAlbumes)
        {
            if (album.ArtistaAlbum.ToLower().Contains(artistaBuscar.ToLower()))
            {
                listaMostrar.Add(album);
            }
        }
    }

    void MostrarTodos()
    {
        listaMostrar = listaAlbumes;
        artistaBuscar = string.Empty;
    }

    void LimpiarCampos()
    {
        tituloAlbum = string.Empty;
        artistaAlbum = string.Empty;
        fechaPublicacion = DateTime.Now;

        nombreCancion = string.Empty;
        artistaCancion = string.Empty;
        tiempoDuracion = 0;

        cancionesTemporales = new List<Cancion>();

        editando = false;
        indiceEditar = -1;
    }
}